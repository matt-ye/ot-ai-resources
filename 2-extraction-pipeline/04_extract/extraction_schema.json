{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One randomized trial, extracted numbers",
  "description": "Every numeric value is kept as a string exactly as printed in the paper, or the word Unclear. Never convert, round or compute.",
  "type": "object",
  "required": ["pmid", "design", "arms", "notes"],
  "properties": {
    "pmid": {"type": "string", "pattern": "^[0-9]+$"},
    "design": {"type": "string", "enum": ["parallel", "crossover", "Unclear"]},
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["arm_name", "intervention_summary", "n_randomized", "n_analyzed",
                     "fma_ue_pre", "fma_ue_post", "fma_ue_change", "timepoint"],
        "properties": {
          "arm_name": {"type": "string"},
          "intervention_summary": {"type": "string"},
          "n_randomized": {"$ref": "#/$defs/count"},
          "n_analyzed": {"$ref": "#/$defs/count"},
          "fma_ue_pre": {"$ref": "#/$defs/score"},
          "fma_ue_post": {"$ref": "#/$defs/score"},
          "fma_ue_change": {"$ref": "#/$defs/score"},
          "timepoint": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "count": {
      "type": "object",
      "required": ["value", "quote", "location"],
      "properties": {
        "value": {"type": "string"},
        "quote": {"type": "string"},
        "location": {"type": "string"}
      }
    },
    "score": {
      "type": "object",
      "required": ["mean", "dispersion", "dispersion_type", "quote", "location"],
      "properties": {
        "mean": {"type": "string"},
        "dispersion": {"type": "string"},
        "dispersion_type": {"type": "string", "enum": ["SD", "SE", "95% CI", "IQR", "Unclear", ""]},
        "quote": {"type": "string"},
        "location": {"type": "string"}
      }
    }
  }
}
