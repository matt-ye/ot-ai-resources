# 本機使用 AI 篩選時，才需要金鑰。不填也能跑（全列、不篩選）。
# 用法：把這個檔複製成 .env，填上你申請的金鑰，再照 README 的 A 段把它載入。
# .env 已列在 .gitignore，用 git 指令時不會被加入；但網頁拖拉上傳不受 .gitignore 管，上傳前請先移走 .env。
# 放上 GitHub 自動執行時，金鑰要存成 Secret，不要放檔案（步驟見 repo 根目錄 README「API 金鑰一律不上傳」）。
# 三組擇一即可；多設幾組，前一家失敗時會自動換下一家。

NVIDIA_API_KEY=
GROQ_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 選填：釘住某個模型（平常留空，程式會自己挑現在還在服務的模型）
NIM_MODEL=
GROQ_MODEL=
CF_AI_MODEL=

# 選填：Europe PMC 要求留聯絡方式。要不要填個人信箱由你決定。
LITWATCH_CONTACT=
